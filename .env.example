# Copy to .env.local and fill in. Never commit .env.local.
# Generate the two secrets with: npm run keygen

# Postgres. Neon's HTTP driver is used for *.neon.tech, standard pg otherwise.
DATABASE_URL=

# Signs the session cookie. Rotating it signs everybody out.
SESSION_SECRET=

# Encrypts stored Notion tokens at rest. Rotating it makes them unreadable
# and every user must reconnect — deliberately, because losing the tokens
# beats keeping them readable.
ENCRYPTION_KEY=

# IANA zone that decides when a day rolls over for streaks and the heatmap.
APP_TIMEZONE=

# Anthropic, for the character companion (Claude Haiku). Server-side only —
# it is read in the route handler and never reaches the browser. Leave it
# blank and the companion degrades to a "not set up yet" state rather than
# erroring. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional: a hosted voice for the companion ------------------------------
# Leave TTS_API_KEY blank and none of this exists: the companion generates
# speech in the browser, free and private, and the route below answers "not
# configured". Set it and the companion answers in a few hundred milliseconds
# instead of a few seconds, because the generating happens somewhere with a
# GPU.
#
# The trade is money and privacy, which is why it is a key rather than a
# default: every reply costs a fraction of a cent, and the text of that reply
# is sent to the provider. What is NOT sent is the other half of the
# conversation — only the companion's own words are ever read out.
#
# The request shape is OpenAI's /audio/speech, which several providers
# implement, so pointing TTS_BASE_URL elsewhere is usually all it takes.
TTS_API_KEY=
# Defaults to https://api.openai.com/v1
TTS_BASE_URL=
# Defaults to tts-1. Any model the provider offers.
TTS_MODEL=
# Defaults to alloy. Any voice the model offers.
TTS_VOICE=
