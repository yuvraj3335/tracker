# Copy to .env.local and fill in. Never commit .env.local.
# Generate the two secrets with: npm run keygen

# Postgres. Neon's HTTP driver is used for *.neon.tech, standard pg otherwise.
DATABASE_URL=

# Signs the session cookie. Rotating it signs everybody out.
SESSION_SECRET=

# Encrypts stored Notion tokens at rest. Rotating it makes them unreadable
# and every user must reconnect — deliberately, because losing the tokens
# beats keeping them readable.
ENCRYPTION_KEY=

# IANA zone that decides when a day rolls over for streaks and the heatmap.
APP_TIMEZONE=

# Groq, for the character companion. Server-side only — it is read in the
# route handler and never reaches the browser. Leave it blank and the
# companion degrades to a "not set up yet" state rather than erroring.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
