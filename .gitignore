# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is names only, never values — it is the documentation for what
# has to be set, so it is the one env file that belongs in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env.local
.env*.local

# Installed character artwork. Whoever runs this instance holds the rights to
# whatever they put here, so nothing under it is committed — the folder ships
# with only its README and the one character below, and otherwise falls back to
# the built-in SVG mascots.
# `npm run fixtures:characters` writes placeholders here for testing.
/public/characters/*
!/public/characters/README.md

# Only the two original Miso variants are shipped. Other owner-installed
# characters stay ignored and never enter this public repo by accident.
!/public/characters/miso/
!/public/characters/miso/**
!/public/characters/miso-classic/
!/public/characters/miso-classic/**
